{
  "name": "prepio",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "jsdom": "26.1.0"
    }
  },
  "scripts": {
    "test": "pnpm -r test",
    "seed": "pnpm --filter @prepio/content seed",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
