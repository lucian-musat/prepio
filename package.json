{
  "name": "prepio",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "jsdom": "26.1.0"
    }
  },
  "scripts": {
    "test": "pnpm -r test",
    "seed": "pnpm --filter @prepio/content seed",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:new": "supabase migration new",
    "db:cloud": "bash scripts/supabase-cloud.sh",
    "db:cloud:status": "bash scripts/supabase-cloud.sh migration list --linked",
    "db:cloud:push:dry": "bash scripts/supabase-cloud.sh db push --linked --dry-run",
    "db:cloud:push": "bash scripts/supabase-cloud.sh db push --linked",
    "content:cloud:add-cards": "bash scripts/content-cloud.sh add-cards",
    "content:cloud:add-consolidation": "bash scripts/content-cloud.sh add-consolidation",
    "content:cloud:sync-consolidation": "bash scripts/content-cloud.sh sync-consolidation",
    "content:cloud:remove-test-lessons": "bash scripts/content-cloud.sh remove-test-lessons",
    "content:demo": "pnpm --filter @prepio/content demo",
    "content:cloud:demo": "bash scripts/content-cloud.sh demo",
    "content:cloud:update-ai-settings": "bash scripts/content-cloud.sh update-ai-settings",
    "content:cloud:ai-templates": "bash scripts/content-cloud.sh ai-templates",
    "content:cloud:bac-subjects": "bash scripts/content-cloud.sh bac-subjects"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
