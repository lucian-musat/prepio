# LOCAL DEVELOPMENT ONLY. Copy to `.env` for local Supabase; never put cloud credentials in `.env`
# (the integration/e2e suites load it and refuse to run unless the Supabase host is 127.0.0.1/localhost).
# Cloud commands get their env inline instead, e.g.:
#   SUPABASE_URL=https://<project>.supabase.co SUPABASE_SERVICE_ROLE_KEY=<key> ADMIN_EMAIL=<email> ADMIN_PASSWORD=<pw> pnpm seed
# `pnpm seed` leaves existing content untouched once any lesson exists; SEED_RESET=1 (or `pnpm seed --reset`)
# replaces ALL content, including lessons written in the admin.

# Local Supabase defaults (public local-dev keys from `pnpm exec supabase status`; never use real secrets here).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=<secret key from: pnpm exec supabase status>

# Local admin user created by `pnpm seed` (local only).
ADMIN_EMAIL=admin@prepio.local
ADMIN_PASSWORD=prepio-local-admin
