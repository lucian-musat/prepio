EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
EXPO_PUBLIC_API_URL=http://localhost:3000
# Google OAuth WEB client id (public, not a secret). Android native sign-in passes it as webClientId so Google
# issues an id token Supabase can verify; the Android OAuth client (package dev.musat.prepio) must also exist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=937265826350-m2821ldcll6s563875sq2m479dl955s3.apps.googleusercontent.com
# Show the "email code" sign-in button. Local dev: true (codes land in Mailpit, http://127.0.0.1:54324).
# Production keeps it false until a domain + SMTP exist (see docs/auth-setup.md).
EXPO_PUBLIC_AUTH_EMAIL_ENABLED=true
# Origin of the admin app (scheme + host + port, no trailing slash). The /preview page accepts card messages only
# from this origin and posts its ready message only to it; unset, the preview ignores every message.
EXPO_PUBLIC_ADMIN_ORIGIN=http://localhost:3000
