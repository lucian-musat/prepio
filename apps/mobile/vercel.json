{
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec expo export -p web",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/preview",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://prepio-admin.vercel.app http://localhost:3000" }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!_expo/|assets/|.*[.].*).*)", "destination": "/index.html" }]
}
