{
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "bash scripts/build-web.sh",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/preview(/.*)?",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://admin.prepio.ro http://localhost:3000" }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!_expo/|assets/|.*[.].*).*)", "destination": "/index.html" }]
}
